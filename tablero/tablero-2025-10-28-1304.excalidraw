      "isDeleted": false,
      "boundElements": [],
      "updated": 1762171327430,
      "link": null,
      "locked": false,
      "text": "\nadmin{\n    ---usuarios----\n    /crear_usuario y json\n    /modificarusuario/id y json\n    /eliminar_usuario/id\n    /mostrar_usuario/id\n    /mostrar_usuarios/\n    ------roles------\n    /add_rol_usuario\n    /eliminar_rol_usuario\n    ----jugadores(carta)-----\n    /crear_jugador y json\n    /modificar_jugador/id y json\n    /eliminar_jugador -> comprueba si no está en ningún equipo \n        //borrado pasivo(campo en bd \"activo\")\n    /mostrar_jugador/id\n    /mostrar_jugadores/\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nadmin{\n    ---usuarios----\n    /crear_usuario y json\n    /modificarusuario/id y json\n    /eliminar_usuario/id\n    /mostrar_usuario/id\n    /mostrar_usuarios/\n    ------roles------\n    /add_rol_usuario\n    /eliminar_rol_usuario\n    ----jugadores(carta)-----\n    /crear_jugador y json\n    /modificar_jugador/id y json\n    /eliminar_jugador -> comprueba si no está en ningún equipo \n        //borrado pasivo(campo en bd \"activo\")\n    /mostrar_jugador/id\n    /mostrar_jugadores/\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
