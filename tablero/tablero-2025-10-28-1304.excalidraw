    {
      "id": "mNg-WnzT5ywcIRnPwYlOZ",
      "type": "text",
      "x": 533,
      "y": 417.5,
      "width": 607.319580078125,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 1187644175,
      "version": 531,
      "versionNonce": 1302172175,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761652690650,
      "link": null,
      "locked": false,
      "text": "\nadmin{\n    ---usuarios----\n    /crear_usuario y json\n    /modificarusuario/id y json\n    /eliminar_usuario/id\n    /mostrar_usuario/id\n    /mostrar_usuarios/\n    ------roles------\n    /add_rol_usuario\n    /eliminar_rol_usuario\n    ----jugadores-----\n    /crear_jugador y json\n    /modificar_jugador/id y json\n    /eliminar_jugador -> comprueba si no está en ningún equipo \n        //borrado pasivo(campo en bd \"activo\")\n    /mostrar_jugador/id\n    /mostrar_jugadores/\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nadmin{\n    ---usuarios----\n    /crear_usuario y json\n    /modificarusuario/id y json\n    /eliminar_usuario/id\n    /mostrar_usuario/id\n    /mostrar_usuarios/\n    ------roles------\n    /add_rol_usuario\n    /eliminar_rol_usuario\n    ----jugadores-----\n    /crear_jugador y json\n    /modificar_jugador/id y json\n    /eliminar_jugador -> comprueba si no está en ningún equipo \n        //borrado pasivo(campo en bd \"activo\")\n    /mostrar_jugador/id\n    /mostrar_jugadores/\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
