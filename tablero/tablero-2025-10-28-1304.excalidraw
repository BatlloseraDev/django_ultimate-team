      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nusuario{\n    /crear_equipo ->id por json comprobar que no tenga equipo\n    /consultar_equipo/ id por json\n    /add_jugador/ idjugador  idusuario por json\n        -> comprobar requisitos\n    /eliminar_jugador (extra)\n    \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
